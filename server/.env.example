# Server port (local only)
PORT=5000
NODE_ENV=development

# MongoDB connection string. Leave empty in development to use an in-memory database.
MONGODB_URI=

# Long random string used to sign auth tokens (required in production)
JWT_SECRET=change-me-to-a-long-random-string

# Origin of the React client (used for CORS when client and API are on different origins)
CLIENT_ORIGIN=http://localhost:5173

# Shared secret for the scheduled alert sweep endpoint (GET /api/cron/alerts)
CRON_SECRET=

# Set to false on serverless hosts where in-process cron jobs cannot run
ENABLE_CRON=true

# Serve the built client (client/dist) from Express, for single-server hosts like Render
SERVE_CLIENT=false
